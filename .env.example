# URL base do backend (sem barra no final).
# Opcional: se omitida, o padrão é http://localhost:8080 em desenvolvimento
# e http://api:8080 em produção (nome do serviço na rede Docker).
# API_URL=http://localhost:8080
# AUTH_API_URL também é aceita como alternativa para compatibilidade.

# Segredo HS256 compartilhado com o backend que emite os tokens JWT
JWT_SECRET=troque-por-um-segredo-forte-e-unico
